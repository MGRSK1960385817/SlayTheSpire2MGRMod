{
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "[sine]……一顆……不屬於這裡的……星辰……[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/neow/neow_welcome",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "回應",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "喔，我感受到……你的聲音中帶著痛苦……與仇恨。",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "繼續",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "[sine]……向上吧……很快……你會……\n……理解我的……[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient.sfx": "event:/sfx/npcs/neow/neow_curious",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "[sine]……外來者……你的內心……充滿……疑惑……\n……殺死……[red]建築師[/red]……揭開……一切……[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/neow/neow_curious",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "回應",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "嘿，沒必要這樣誘導我！……不過在這一點上，我同意。",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "繼續",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "[sine]……很好……\n……我就喜歡……你這樣的孩子……[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient.sfx": "event:/sfx/npcs/neow/neow_sleepy",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "[sine]……墜落……\n……而後……升起……[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/neow/neow_sleepy",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "哇！你身上有好多我從來沒見過的東西，比如那支麥克風！\n可以給我嗎？我拿好多好東西跟你換！",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/darv/darv_introduction",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "回應",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "嗯……現在還不行，我還要用呢。\n不過等一切都結束後，我會考慮看看的。",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "繼續",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "好啊！一定要再來啊！",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "我一直覺得有些怪！你身上的有些東西給我的感覺相當古老，但其餘的又嶄新。",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/darv/darv_endeared",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "回應",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "我的故事說來可長了——就像你的那些藏品一樣。等我有空，我們慢慢聊吧！",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "繼續",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "好啊！真不錯！我會一直待在這裡，記得再來啊！",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "嘿，快來看！我特地挑的亮晶晶寶貝！",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "哦，一名遠道而來的歌者。靠近點，讓我聆聽你的聲音。",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_welcome",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "回應",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "我很樂意，尊貴的女士！但我還趕著去殺[red]建築師[/red]呢。",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "繼續",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "真是個急性子的小姑娘。不過你還是得靠近些，不然我沒辦法為你賜福。",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "建築師喜歡井然有序的旋律，但像你這樣的不諧之音，他只會盡力扼殺。",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_giggle",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "回應",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "喔！那就比比看誰更厲害吧！",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "漂亮的小星星，來看看我為你準備的妝點。",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_welcome",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "星星！？新的星星！也是從外面來的？你有故事嗎！！",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "回應",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "你好啊小傢伙！\n我確實來自一個很遠的地方……不過這就說來話長了。",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "繼續",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "沒關係！！說說看？！我想聽！！",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "你身上，閃閃發亮！？怎麼做到的？！讓我看看？！",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "回應",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "喔，你真的和小狗一樣！\n[jitter]呀啊啊啊啊啊啊不要突然靠這麼近————[/jitter]",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "繼續",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "對不起！！對不起！！",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "快來！！亮閃閃的東西！！給你！！",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "[thinky_dots]遠道而來的旅者……你的內心，並不如外表般平靜……[/thinky_dots]",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "回應",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "嗯哼……能走到這裡的，誰沒有自己的心事呢？",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "繼續",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "[thinky_dots]早點放下這一切吧……[/thinky_dots]",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "[thinky_dots]你的聲音有些疲倦……睡一覺吧，可憐的孩子……[/thinky_dots]",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "回應",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "都怪這塔裡太吵了！\n不過，你這裡倒是安靜。或許我可以試試？",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "繼續",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "[thinky_dots]歡迎……[/thinky_dots]",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.char": "喔，大龍龍，你還在睡覺嗎？\n……我會輕一點的。",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "[b]細手細腳！？真是丟人！[/b]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/tanx/tanx_laugh",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "回應",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "我可不是那種靠蠻力的大塊頭。",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "繼續",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "[b]沒力氣，要怎麼戰鬥？！[/b]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient.sfx": "event:/sfx/npcs/tanx/tanx_curiosity",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "[b]瘦小的存在！！拿出力氣來！！[/b]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "回應",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "才不要，你渾身都是血腥味，臭烘烘的。\n略略略————來抓我啊！",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "繼續",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "[jitter][b]吼啊啊啊啊啊啊！！[/b][/jitter]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "[b]放大嗓門！！像個真正的戰士一樣！！[/b]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.next": "吼叫",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-1r.char": "[jitter][b]哇啊啊啊啊啊啊！！[/b][/jitter]咳咳",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "哎呀，一個迷路的小姑娘。來吧，親愛的，來喝口[jitter][b]熱茶[/b][/jitter]。",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "接受",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "好啊，謝謝你！我正好有點餓了。\n喔對了，你這裡有[jitter][b]餅乾[/b][/jitter]嗎？",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "繼續",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "呵呵，都有都有……專門為遠道而來的客人[jitter][b]烘烤[/b][/jitter]……",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "又來啦，親愛的？喔，年紀輕輕就要面對這些事，你肯定很[jitter][b]孤單[/b][/jitter]吧？",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "回應",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "其實還好！我有很多朋友，雖然他們都不在這裡……\n喔！可能有！",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "繼續",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "那可真不錯！希望有一天，大家能一起開個[jitter][b]茶會[/b][/jitter]……",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "路上辛苦了，小星星！來杯香醇的[jitter][b]紅茶[/b][/jitter]吧？",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "啊，這位美麗的女士，我這裡有許多提案能增添您的魅力……\n又或者，您更渴望[jitter][b]力量[/b][/jitter]？",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "回應",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "你真會說話！不過嘛，我之前待的那個地方，很多人都不太講信用……我能相信你嗎？",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "繼續",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "契約條目，白紙黑字，明碼標價，任君查閱！",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "我能感受到，你的野心很大，絕不僅僅是建築師……",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "回應",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "哎呀！被你發現了。其實呢，我還真想試試你的斤兩！",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "繼續",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "真不錯！我喜歡你的[jitter][b]慾望。[/b][/jitter]",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "你就不想知道，跟你一同遠道而來的夥伴在哪裡嗎？",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0r.ancient": "你的到來遠超我的意料。",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0r.next": "回應",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1r.char": "再厲害的天文學家也算不到每一顆星星喔？",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1r.next": "繼續",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2r.ancient": "無法忽視的噪點，必須予以清除。",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0r.ancient": "你已成為這座塔的噪音。離開吧，這對你我都好。",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0r.next": "回應",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1r.char": "假如這就是我想達到的效果呢？",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1r.next": "繼續",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2r.ancient": "那隻能請你[b]靜音[/b]了。",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "你天真到以為，不斷重複同一段旋律，就能得到不同的結果？",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.next": "回應",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-1r.char": "當然啦。你看，我每次都會更快一點。",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-1r.next": "繼續",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-2r.ancient": "不會再有下一次了。"
}

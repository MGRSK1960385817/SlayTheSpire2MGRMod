  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/darv/darv_endeared",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "대답",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "내 이야기는 길어. 네 수집품만큼이나! 시간 나면 천천히 얘기하자!",

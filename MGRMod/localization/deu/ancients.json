{
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "[sine]...ein... ..Stern... der nicht hierhergehört...[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/neow/neow_welcome",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Antworten",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Oh, ich spüre es … In deiner Stimme liegen Schmerz … und Hass.",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Weiter",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "[sine]...steig hinauf..bald.. wirst du...\n.. ...mich verstehen...[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient.sfx": "event:/sfx/npcs/neow/neow_curious",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "[sine]...Fremde...dein Inneres... ist voller..Zweifel...\n...töte..den [red]Architekten[/red]...enthülle..alles... ..[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/neow/neow_curious",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Antworten",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "Hey, du musst mich nicht so lenken! … Aber in diesem Punkt stimme ich dir zu.",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Weiter",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "[sine]...sehr gut...\n...Kinder wie dich... mag ich...[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient.sfx": "event:/sfx/npcs/neow/neow_sleepy",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "[sine]...falle...\n...und dann..steig empor.....[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/neow/neow_sleepy",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "Wow! Du hast ja so viel Kram, den ich noch nie gesehen hab – zum Beispiel das Mikrofon da!\nGibste mir das? Ich tausch dir ganz viel gutes Zeug dafür!",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/darv/darv_introduction",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Antworten",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Hm … jetzt noch nicht, ich brauche es ja noch.\nAber wenn alles vorbei ist, denk ich drüber nach.",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Weiter",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "Na gut! Kommste unbedingt wieder!",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "Ich hab mich schon die ganze Zeit gewundert! Manche Sachen an dir wirken uralt, aber der Rest ist nagelneu.",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/darv/darv_endeared",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Antworten",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "Meine Geschichte ist lang – genau wie die deiner Sammlerstücke. Wenn ich Zeit habe, reden wir ganz in Ruhe darüber!",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Weiter",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "Ja! Klingt toll! Ich bin immer hier, also kommste wieder!",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "Hey, schau mal! Hab extra was Glitzerndes ausgesucht!",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "Oh, eine Sängerin von weit her. Tritt näher und lass mich deine Stimme vernehmen.",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_welcome",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Antworten",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Sehr gern, edle Dame! Aber ich bin gerade auf dem Weg, den [red]Architekten[/red] zu töten.",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Weiter",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "Was für ein ungeduldiges Mädchen. Du musst dennoch näher treten, sonst kann ich dich nicht segnen.",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "Der Architekt liebt wohlgeordnete Melodien. Einen Missklang wie dich wird er mit aller Macht zum Verstummen bringen wollen.",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_giggle",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Antworten",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "Oh! Dann sehen wir mal, wer von uns stärker ist!",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "Hübsches Sternchen, sieh dir den Schmuck an, den ich für dich vorbereitet habe.",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_welcome",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "Ein Stern!? Ein neuer Stern! Auch von draußen? Hast du Geschichten!!",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Antworten",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Hallo, Kleiner!\nIch komme tatsächlich von sehr weit her … aber das ist eine lange Geschichte.",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Weiter",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "Macht nichts!! Erzähl?! Ich will hören!!",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "Du glitzerst!? Wie machst du das?! Zeig mal?!",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Antworten",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "Oh, du bist wirklich wie ein kleiner Hund!\n[jitter]Aaaaaaaaaah, komm doch nicht plötzlich so nah————[/jitter]",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Weiter",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "Tut mir leid!! Tut mir leid!!",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "Komm schnell!! Glitzerndes Zeug!! Für dich!!",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "[thinky_dots]Reisende von weit her … Dein Inneres ist nicht so ruhig wie dein Äußeres …[/thinky_dots]",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Antworten",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Hm … Wer es bis hierher schafft, trägt wohl seine eigenen Sorgen mit sich, oder?",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Weiter",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "[thinky_dots]Lass all das bald hinter dir …[/thinky_dots]",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "[thinky_dots]Deine Stimme klingt ein wenig müde … Schlaf etwas, armes Kind …[/thinky_dots]",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Antworten",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "Der Spire ist einfach viel zu laut!\nAber hier bei dir ist es ruhig. Vielleicht sollte ich es versuchen?",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Weiter",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "[thinky_dots]Willkommen …[/thinky_dots]",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.char": "Oh, großer Drache, schläfst du noch?\n… Ich bin ganz leise.",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "[b]SO DÜRRE ARME UND BEINE!? EINE SCHANDE![/b]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/tanx/tanx_laugh",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Antworten",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Ich bin kein Muskelprotz, der sich nur auf rohe Kraft verlässt.",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Weiter",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "[b]WIE WILLST DU OHNE KRAFT KÄMPFEN?![/b]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient.sfx": "event:/sfx/npcs/tanx/tanx_curiosity",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "[b]WINZIGES WESEN!! STRENG DICH AN!![/b]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Antworten",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "Nö. Du riechst überall nach Blut. Ganz schön stinkig.\nBäh-bäh-bäh———— Fang mich doch!",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Weiter",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "[jitter][b]BRÜÜÜÜÜÜÜÜLL!![/b][/jitter]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "[b]LAUTER!! WIE EIN ECHTER KRIEGER!![/b]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.next": "Brüllen",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-1r.char": "[jitter][b]WAAAAAAAAAAH!![/b][/jitter] Hust, hust",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "Oh, ein kleines Mädchen, das sich verirrt hat. Komm, Liebes, trink etwas [jitter][b]heißen Tee[/b][/jitter].",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Annehmen",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Gern, danke! Ich bin tatsächlich ein bisschen hungrig.\nAch ja, hast du auch [jitter][b]Kekse[/b][/jitter]?",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Weiter",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "Hehe, natürlich … eigens für Gäste von weit her [jitter][b]gebacken[/b][/jitter] …",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "Schon wieder da, Liebes? Oh, in deinem Alter schon all dem ausgesetzt … Du musst dich sehr [jitter][b]einsam[/b][/jitter] fühlen, nicht wahr?",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Antworten",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "Eigentlich geht es! Ich habe viele Freunde, auch wenn sie nicht hier sind …\nOh! Vielleicht doch!",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Weiter",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "Wie schön! Hoffentlich können wir eines Tages alle zusammen eine [jitter][b]Teegesellschaft[/b][/jitter] feiern …",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "Die Reise war beschwerlich, Sternchen! Wie wäre es mit einer Tasse kräftigem [jitter][b]Schwarztee[/b][/jitter]?",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "Ah, schöne Dame, ich habe viele Angebote, die Ihren Reiz noch steigern könnten …\nOder sehnen Sie sich mehr nach [jitter][b]Macht[/b][/jitter]?",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Antworten",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Du bist ja ein Schmeichler! Aber dort, wo ich vorher war, haben viele ihr Wort nicht gehalten … Kann ich dir vertrauen?",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Weiter",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "Vertragsklauseln, schwarz auf weiß, klar ausgewiesene Preise – prüfen Sie alles in Ruhe!",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "Ich spüre großen Ehrgeiz in dir. Der Architekt allein ist gewiss nicht dein Ziel …",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Antworten",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "Oh! Erwischt. Eigentlich wollte ich schon immer mal sehen, was du auf die Waage bringst!",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Weiter",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "Ausgezeichnet! Mir gefällt dein [jitter][b]Verlangen.[/b][/jitter]",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "Willst du denn gar nicht wissen, wo deine Gefährten von weit her sind?",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0r.ancient": "Deine Ankunft liegt weit außerhalb meiner Berechnungen.",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0r.next": "Antworten",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1r.char": "Selbst der beste Astronom kann nicht jeden Stern berechnen, oder?",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1r.next": "Weiter",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2r.ancient": "Eine nicht zu ignorierende Störung. Sie muss entfernt werden.",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0r.ancient": "Du bist zum Rauschen dieses Spires geworden. Geh. Das ist für uns beide besser.",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0r.next": "Antworten",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1r.char": "Und wenn genau das meine Absicht war?",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1r.next": "Weiter",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2r.ancient": "Dann muss ich dich [b]stummschalten[/b].",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "Bist du so naiv zu glauben, die ständige Wiederholung derselben Melodie könne ein anderes Ergebnis hervorbringen?",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.next": "Antworten",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-1r.char": "Natürlich. Schau doch, ich werde jedes Mal ein bisschen schneller.",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-1r.next": "Weiter",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-2r.ancient": "Es wird kein nächstes Mal geben."
}

{
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "[sine]…ここには…属さぬ… …星…[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/neow/neow_welcome",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "応える",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "ああ、感じる……その声には苦しみ……そして憎しみがある。",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "続ける",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "[sine]…上へ…じきに…お前も…\n… …私を…理解する…[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient.sfx": "event:/sfx/npcs/neow/neow_curious",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "[sine]…異邦の者…心は…疑念に…満ちている…\n…[red]建築家[/red]を…殺せ…すべてが…明らかに… …[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/neow/neow_curious",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "応える",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "ちょっと、そんなふうに誘導しなくてもいいでしょ！……まあ、そこは同意するけど。",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "続ける",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "[sine]…よい…\n…そういう子は…好きだ…[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient.sfx": "event:/sfx/npcs/neow/neow_sleepy",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "[sine]…墜ちて…\n…そして…昇る……[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/neow/neow_sleepy",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "わあ！見たことのない物をたくさん持ってるね。そのマイクとか！\nくれない？いい物をたくさんあげるから！",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/darv/darv_introduction",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "応える",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "うーん……今はまだダメ。使うから。\nでも全部終わったら、考えてあげる！",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "続ける",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "やった！絶対また来てね！",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "ずっと不思議だったんだ！君の持ち物にはすごく古い物もあるのに、他は真新しい。",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/darv/darv_endeared",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "応える",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "私の話は長いよ——あなたのコレクションみたいにね。暇ができたら、ゆっくり話そう！",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "続ける",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "いいね！最高！ずっとここにいるから、また来てね！",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "ねえ、見て！君のために選んだキラキラだよ！",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "まあ、遥かな旅路を越えた歌い手。近くへいらして。その声を聴かせてちょうだい。",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_welcome",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "応える",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "喜んで、高貴なお方！でも私、[red]建築家[/red]を倒しに急いでるの。",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "続ける",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "なんてせっかちな娘でしょう。それでも近くへいらっしゃい。でなければ祝福を授けられないもの。",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "建築家は整然とした旋律を好みます。けれど、あなたのような不協和音は力ずくで消そうとするでしょう。",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_giggle",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "応える",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "へえ！じゃあ、どっちが強いか勝負だね！",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "愛らしい小さな星よ。あなたのために用意した装いをご覧なさい。",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_welcome",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "星！？新しい星！外から来たの？物語があるの！！",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "応える",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "こんにちは、小さい子！\nすごく遠い所から来たのは本当……でも、話すと長いよ。",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "続ける",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "いいよ！！話して？！聞きたい！！",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "君、キラキラ！？どうやるの？！見せて？！",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "応える",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "わあ、本当に子犬みたい！\n[jitter]ぎゃああああ急にそんな近くへ来ないで————[/jitter]",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "続ける",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "ごめん！！ごめん！！",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "来て！！キラキラの物！！あげる！！",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "[thinky_dots]遠路を来た旅人よ……その心は、見た目ほど穏やかではない……[/thinky_dots]",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "応える",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "ふふ……ここまで来た人なら、誰だって胸に何か抱えてるでしょ？",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "続ける",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "[thinky_dots]早く、すべてを手放せるといい……[/thinky_dots]",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "[thinky_dots]声が少し疲れている……眠りなさい、かわいそうな子……[/thinky_dots]",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "応える",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "この塔がうるさすぎるせいだよ！\nでも、ここは静かだね。ちょっと試してみようかな？",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "続ける",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "[thinky_dots]歓迎する……[/thinky_dots]",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.char": "あら、大きな竜さん。まだ寝てるの？\n……静かにするね。",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "[b]ひょろひょろではないか！？情けない！[/b]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/tanx/tanx_laugh",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "応える",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "私は力任せの大男じゃないんだけど。",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "続ける",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "[b]力なくしてどう戦う？！[/b]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient.sfx": "event:/sfx/npcs/tanx/tanx_curiosity",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "[b]小さき者よ！！力を見せろ！！[/b]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "応える",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "やだよ。血の臭いでくさーい。\nべーっ————捕まえてみなよ！",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "続ける",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "[jitter][b]グオオオオオオ！！[/b][/jitter]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "[b]声を張れ！！真の戦士のように！！[/b]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.next": "咆哮する",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-1r.char": "[jitter][b]うわああああああ！！[/b][/jitter]ゴホゴホ",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "まあ、道に迷ったお嬢ちゃん。おいで、かわいい子。[jitter][b]熱いお茶[/b][/jitter]をどうぞ。",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "受け入れる",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "わあ、ありがとう！ちょうどお腹が空いてたの。\nそうだ、[jitter][b]クッキー[/b][/jitter]もある？",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "続ける",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "ふふ、もちろん……遠方からのお客様のために[jitter][b]焼いた[/b][/jitter]のよ……",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "また来たのね、かわいい子？まあ、こんな幼い子が背負うには重すぎるわ。さぞ[jitter][b]寂しい[/b][/jitter]でしょう？",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "応える",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "そうでもないよ！友達はたくさんいるの。今はここにいないけど……\nあっ！いるかも！",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "続ける",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "それは素敵ね！いつか皆で[jitter][b]お茶会[/b][/jitter]を開けるといいわ……",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "旅は大変だったでしょう、小さな星！香り高い[jitter][b]紅茶[/b][/jitter]はいかが？",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "ああ、美しいお嬢様。あなたの魅力を高める案をいくつもご用意しております……\nそれとも、よりお望みなのは[jitter][b]力[/b][/jitter]でしょうか？",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "応える",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "口がうまいね！でもね、前にいた所では約束を守らない人が多かったの……あなたは信用していい？",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "続ける",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "契約条項はすべて明記、価格も明瞭。どうぞ隅々までご確認ください！",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "感じますよ。あなたの野望は大きい。建築家だけではない……",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "応える",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "あら、ばれちゃった！実はね、あなたの実力も測ってみたいの！",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "続ける",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "実に素晴らしい！その[jitter][b]欲望[/b][/jitter]、気に入りました。",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "遠路を共に来た仲間がどこにいるか、知りたくはありませんか？",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0r.ancient": "君の到来は予測を大幅に超えている。",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0r.next": "応える",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1r.char": "どんな天文学者だって、すべての星は数えられないでしょ？",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1r.next": "続ける",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2r.ancient": "無視できないノイズだ。除去する。",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0r.ancient": "君は塔のノイズとなった。去れ。互いのためだ。",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0r.next": "応える",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1r.char": "それが狙いだとしたら？",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1r.next": "続ける",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2r.ancient": "ならば君を[b]ミュート[/b]する。",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "同じ旋律を繰り返し、異なる結果を得られると思うほど愚かなのか？",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.next": "応える",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-1r.char": "もちろん。ほら、毎回ちょっとずつ速くなってる。",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-1r.next": "続ける",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-2r.ancient": "次はない。"
}

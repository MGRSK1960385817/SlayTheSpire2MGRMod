{
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "[sine]...una estrella... que no pertenece... ..a este lugar...[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/neow/neow_welcome",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Responder",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Oh, percibo... dolor... y odio en tu voz.",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Continuar",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "[sine]...asciende.. pronto.. tú...\n.. ...me comprenderás...[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient.sfx": "event:/sfx/npcs/neow/neow_curious",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "[sine]...forastera... tu interior... rebosa.. dudas...\n...mata.. al [red]Arquitecto[/red]... descubre.. todo... ..[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/neow/neow_curious",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Responder",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "¡Oye, no hace falta que me manipules así!... Aunque en eso estamos de acuerdo.",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Continuar",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "[sine]...bien...\n...me gustan... las niñas como tú...[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient.sfx": "event:/sfx/npcs/neow/neow_sleepy",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "[sine]...caer...\n...y después.. alzarse.....[/sine]",
  "NEOW.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/neow/neow_sleepy",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "¡Hala! ¡Llevas un montón de cosas que nunca había visto, como ese micrófono!\n¿Me lo das? ¡Te lo cambio por un montón de cosas buenas!",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/darv/darv_introduction",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Responder",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Mmm... Ahora mismo no, todavía lo necesito.\nPero cuando todo esto acabe, me lo pensaré.",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Continuar",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "¡Vale! ¡Tienes que volver, ¿eh?!",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "¡Siempre me ha parecido muy raro! Algunas cosas que llevas parecen antiquísimas, pero las demás son completamente nuevas.",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/darv/darv_endeared",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Responder",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "Mi historia es larguísima, tanto como tu colección. ¡Cuando tenga tiempo, te la contaré con calma!",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Continuar",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "¡Vale! ¡Genial! Yo siempre estoy aquí. ¡Acuérdate de volver!",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "¡Eh, mira! ¡He elegido algo brillante especialmente para ti!",
  "DARV.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "Oh, una cantante llegada de muy lejos. Acércate y déjame escuchar tu voz.",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_welcome",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Responder",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "¡Será un placer, noble dama! Pero tengo prisa por matar al [red]Arquitecto[/red].",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Continuar",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "Qué jovencita tan impaciente. Pero tendrás que acercarte o no podré concederte mi bendición.",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "Al Arquitecto le gustan las melodías ordenadas. Una disonancia como tú es algo que tratará de silenciar.",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_giggle",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Responder",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "¡Ah! ¡Pues veamos quién de los dos puede más!",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "Preciosa estrellita, ven a ver los adornos que he preparado para ti.",
  "NONUPEIPE.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_welcome",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "¿¡Una estrella!? ¡Una estrella nueva! ¿También vienes de fuera? ¡¡¿Tienes historias?!!",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Responder",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "¡Hola, pequeñín!\nSí que vengo de muy lejos... Pero es una historia larga.",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Continuar",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "¡¡No pasa nada!! ¿¡Cuéntamela!? ¡¡Quiero oírla!!",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "¿¡Brillas!? ¿¡Cómo lo haces!? ¿¡Puedo verlo!?",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Responder",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "¡Ay, eres igualito que un perrito!\n[jitter]Aaaaaaaah, no te acerques tanto de repenteeeee...[/jitter]",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Continuar",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "¡¡Lo siento!! ¡¡Lo siento!!",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "OROBAS.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "¡¡Ven rápido!! ¡¡Algo brillante!! ¡¡Para ti!!",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "[thinky_dots]Viajera llegada de muy lejos... Tu interior no está tan sereno como aparentas...[/thinky_dots]",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Responder",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Mmm... Nadie llega hasta aquí sin llevar sus propias preocupaciones a cuestas, ¿no?",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Continuar",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "[thinky_dots]Ojalá puedas dejarlo todo atrás pronto...[/thinky_dots]",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "[thinky_dots]Tu voz suena cansada... Duerme un poco, pobre niña...[/thinky_dots]",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Responder",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "¡Es que esta Torre es demasiado ruidosa!\nPero aquí sí que se está tranquilo. ¿Quizá podría intentarlo?",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Continuar",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "[thinky_dots]Bienvenida...[/thinky_dots]",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "PAEL.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.char": "Oh, dragoncito, ¿sigues durmiendo?\n...Iré con cuidado.",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "[b]¿¡ESOS BRAZOS ESCUÁLIDOS!? ¡¡QUÉ VERGÜENZA!![/b]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/tanx/tanx_laugh",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Responder",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Yo no soy uno de esos grandullones que solo saben usar la fuerza bruta.",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Continuar",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "[b]¡¡¿CÓMO VAS A LUCHAR SIN FUERZA?!![/b]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient.sfx": "event:/sfx/npcs/tanx/tanx_curiosity",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "[b]¡¡SER DIMINUTO!! ¡¡PONLE GANAS!![/b]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Responder",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "Ni hablar, apestas a sangre.\n¡Tururúúú! ¡A ver si me pillas!",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Continuar",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "[jitter][b]¡¡¡ROAAAAAAAR!!![/b][/jitter]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "[b]¡¡ALZA LA VOZ!! ¡¡COMO UNA AUTÉNTICA GUERRERA!![/b]",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.next": "Rugir",
  "TANX.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-1r.char": "[jitter][b]¡¡¡AAAAAAAH!!![/b][/jitter] Cof, cof.",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "Vaya, una jovencita perdida. Ven, cariño, toma un poco de [jitter][b]té caliente[/b][/jitter].",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Aceptar",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "¡Vale, gracias! Justo empezaba a tener hambre.\nPor cierto, ¿tienes [jitter][b]galletas[/b][/jitter]?",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Continuar",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "Je, je. Hay de todo... [jitter][b]horneado[/b][/jitter] especialmente para quienes vienen de muy lejos...",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "¿Otra vez por aquí, cariño? Oh, tener que afrontar todo esto siendo tan joven... Debes de sentirte muy [jitter][b]sola[/b][/jitter], ¿verdad?",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Responder",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "¡Pues no tanto! Tengo un montón de amigos, aunque no estén aquí...\n¡Ah! ¡Puede que alguno sí!",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Continuar",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "¡Qué maravilla! Espero que algún día podamos celebrar juntos una [jitter][b]fiesta del té[/b][/jitter]...",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "TEZCATARA.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "¡El camino ha sido largo, estrellita! ¿Te apetece una taza de intenso [jitter][b]té negro[/b][/jitter]?",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "Ah, bella dama. Dispongo de numerosas propuestas para realzar aún más su encanto...\n¿O acaso desea [jitter][b]poder[/b][/jitter]?",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Responder",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "¡Qué labia tienes! Pero de donde vengo había mucha gente que no cumplía su palabra... ¿Puedo fiarme de ti?",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Continuar",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "¡Cláusulas por escrito, condiciones transparentes y precios claramente indicados para que los examine!",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "Percibo una ambición inmensa en ti, una que va mucho más allá del Arquitecto...",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Responder",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "¡Vaya! Me has descubierto. La verdad es que también tengo ganas de medirme contigo.",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Continuar",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "¡Magnífico! Me gusta tu [jitter][b]deseo.[/b][/jitter]",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "VAKUU.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "¿No deseas saber dónde están tus compañeros llegados de tan lejos?",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0r.ancient": "Tu llegada supera con creces mis previsiones.",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-0r.next": "Responder",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1r.char": "Ni el mejor astrónomo puede contar todas y cada una de las estrellas, ¿no?",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-1r.next": "Continuar",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.0-2r.ancient": "Una interferencia imposible de ignorar. Debe eliminarse.",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0r.ancient": "Te has convertido en el ruido de esta Torre. Márchate. Será mejor para ambos.",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-0r.next": "Responder",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1r.char": "¿Y si ese es justo el efecto que busco?",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-1r.next": "Continuar",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.1-2r.ancient": "Entonces tendré que [b]silenciarte[/b].",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "¿Eres tan ingenua que crees que repetir la misma melodía producirá un resultado diferente?",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.next": "Responder",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-1r.char": "Claro. Mira, cada vez voy un poquito más rápido.",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-1r.next": "Continuar",
  "THE_ARCHITECT.talk.MGR_MOD_CHARACTER_MGR_CHARACTER.2-2r.ancient": "No habrá una próxima vez."
}

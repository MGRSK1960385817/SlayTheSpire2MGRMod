{
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "[sine]...a star... that does not belong... ..here...[/sine]",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/neow/neow_welcome",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Respond",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Oh, I can feel it... Your voice carries pain... and hatred.",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Continue",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "[sine]...ascend.. soon.. you will...\n.. ...understand me...[/sine]",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient.sfx": "event:/sfx/npcs/neow/neow_curious",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "[sine]...outsider... your heart... is filled.. with doubt...\n...slay.. the [red]Architect[/red]... uncover.. everything... ..[/sine]",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/neow/neow_curious",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Respond",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "Hey, you don't have to bait me like that!... Though on this point, I agree.",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Continue",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "[sine]...good...\n...I do like... children like you...[/sine]",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient.sfx": "event:/sfx/npcs/neow/neow_sleepy",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "[sine]...fall...\n...and then.. rise.....[/sine]",
  "NEOW.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/neow/neow_sleepy",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "Wow! You've got so many things I've never seen before, like that microphone!\nCan I have it? I'll trade you lots of great stuff for it!",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/darv/darv_introduction",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Respond",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Hmm... not right now. I still need it.\nBut once everything is over, I'll think about it!",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Continue",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "All right! Make sure you come back!",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "I've always thought something was strange! Some of your things feel incredibly ancient, while the rest feel brand-new.",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/darv/darv_endeared",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Respond",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "My story is a long one—just like your collection. When I have time, we can talk it over at our leisure!",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Continue",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "Sure! That sounds great! I'll be right here, so remember to come back!",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "Hey, come look! I picked out these shinies especially for you!",
  "DARV.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/darv/darv_excited",
  "NONUPEIPE.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "NONUPEIPE.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "Oh, a singer from afar. Come closer, and let me hear your voice.",
  "NONUPEIPE.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_welcome",
  "NONUPEIPE.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Respond",
  "NONUPEIPE.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "I'd be delighted, my noble lady! But I'm in a hurry to go kill the [red]Architect[/red].",
  "NONUPEIPE.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Continue",
  "NONUPEIPE.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "What an impatient little girl. But you still have to come closer, or I cannot bestow my blessing upon you.",
  "NONUPEIPE.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "NONUPEIPE.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "The Architect favors melodies in perfect order, but a discordant note like you is something he will do his utmost to silence.",
  "NONUPEIPE.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_giggle",
  "NONUPEIPE.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Respond",
  "NONUPEIPE.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "Oh! Then we'll see which of us is stronger!",
  "NONUPEIPE.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "NONUPEIPE.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "Pretty little star, come see the adornments I prepared for you.",
  "NONUPEIPE.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/nonupeipe/nonupeipe_welcome",
  "OROBAS.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "OROBAS.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "A star!? A new star! Are you from outside too? Do you have a story!!",
  "OROBAS.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Respond",
  "OROBAS.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Hello, little one!\nI really do come from somewhere very far away... but that's a long story.",
  "OROBAS.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Continue",
  "OROBAS.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "That's okay!! Tell me?! I want to hear it!!",
  "OROBAS.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "OROBAS.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "You're all sparkly!? How do you do that?! Let me see?!",
  "OROBAS.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Respond",
  "OROBAS.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "Oh, you really are just like a puppy!\n[jitter]Yaaaaaaaah, don't suddenly get so close————[/jitter]",
  "OROBAS.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Continue",
  "OROBAS.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "Sorry!! Sorry!!",
  "OROBAS.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "OROBAS.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "Come quick!! Shiny things!! For you!!",
  "PAEL.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "PAEL.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "[thinky_dots]Traveler from afar... your heart is not as tranquil as your appearance...[/thinky_dots]",
  "PAEL.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Respond",
  "PAEL.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Mm-hmm... Who could make it this far without carrying a few troubles of their own?",
  "PAEL.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Continue",
  "PAEL.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "[thinky_dots]May you let go of it all soon...[/thinky_dots]",
  "PAEL.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "PAEL.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "[thinky_dots]Your voice sounds weary... Sleep for a while, poor child...[/thinky_dots]",
  "PAEL.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Respond",
  "PAEL.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "It's all because this tower is so noisy!\nBut it is quiet here. Maybe I could give it a try?",
  "PAEL.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Continue",
  "PAEL.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "[thinky_dots]You are welcome here...[/thinky_dots]",
  "PAEL.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "PAEL.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.char": "Oh, big dragon, are you still sleeping?\n...I'll be quiet.",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "[b]Such scrawny arms and legs!? Pathetic![/b]",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient.sfx": "event:/sfx/npcs/tanx/tanx_laugh",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Respond",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "I'm not some musclebound brute who relies on raw strength.",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Continue",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "[b]How can you fight without strength?![/b]",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient.sfx": "event:/sfx/npcs/tanx/tanx_curiosity",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "[b]Tiny creature!! Put some muscle into it!![/b]",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Respond",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "No way! You reek of blood. You're stinky.\nBleh-bleh-bleh————catch me if you can!",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Continue",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "[jitter][b]ROAAAAAAAR!![/b][/jitter]",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "[b]Raise your voice!! Like a true warrior!![/b]",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient.sfx": "event:/sfx/npcs/tanx/tanx_roar",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.next": "Roar",
  "TANX.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-1r.char": "[jitter][b]WAAAAAAAARGH!![/b][/jitter] Cough, cough...",
  "TEZCATARA.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "TEZCATARA.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "Oh my, a lost little girl. Come, dear, have a sip of [jitter][b]hot tea[/b][/jitter].",
  "TEZCATARA.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Accept",
  "TEZCATARA.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "Sure, thank you! I was getting a little hungry.\nOh, by the way, do you have any [jitter][b]cookies[/b][/jitter]?",
  "TEZCATARA.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Continue",
  "TEZCATARA.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "Hehe, of course... [jitter][b]baked[/b][/jitter] especially for a guest from afar...",
  "TEZCATARA.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "TEZCATARA.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "Back again, dear? Oh, a half-grown child having to face all this... You must be so [jitter][b]lonely[/b][/jitter], aren't you?",
  "TEZCATARA.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Respond",
  "TEZCATARA.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "I'm actually all right! I have lots of friends, though none of them are here...\nOh! Maybe one is!",
  "TEZCATARA.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Continue",
  "TEZCATARA.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "How wonderful! I hope that one day, everyone can gather for a [jitter][b]tea party[/b][/jitter]...",
  "TEZCATARA.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "TEZCATARA.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "You have traveled far, little star! How about a cup of rich [jitter][b]black tea[/b][/jitter]?",
  "VAKUU.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "VAKUU.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.ancient": "Ah, my beautiful lady, I have many proposals that could enhance your charm...\nOr is it [jitter][b]power[/b][/jitter] that you desire more?",
  "VAKUU.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0.next": "Respond",
  "VAKUU.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.char": "You certainly have a silver tongue! But where I used to live, a lot of people didn't keep their promises... Can I trust you?",
  "VAKUU.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1.next": "Continue",
  "VAKUU.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-2.ancient": "Every clause in black and white, every price clearly marked, all yours to inspect!",
  "VAKUU.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "VAKUU.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.ancient": "I can sense that your ambitions are vast—and extend far beyond the Architect...",
  "VAKUU.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0.next": "Respond",
  "VAKUU.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.char": "Oh my! You noticed. Truth be told, I'd quite like to test your measure!",
  "VAKUU.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1.next": "Continue",
  "VAKUU.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-2.ancient": "Marvelous! I like your [jitter][b]desire.[/b][/jitter]",
  "VAKUU.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "VAKUU.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "Don't you want to know where your companions from afar are now?",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-visit": "0",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0r.ancient": "Your arrival lies far beyond my calculations.",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-0r.next": "Respond",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1r.char": "Even the greatest astronomer can't account for every single star, can they?",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-1r.next": "Continue",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.0-2r.ancient": "An unignorable artifact. It must be removed.",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-visit": "1",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0r.ancient": "You have become noise within this Spire. Leave. It would be better for us both.",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-0r.next": "Respond",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1r.char": "What if that's exactly the effect I wanted?",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-1r.next": "Continue",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.1-2r.ancient": "Then I will have to [b]mute[/b] you.",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-visit": "2",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.ancient": "Are you naive enough to believe that repeating the same melody over and over will produce a different result?",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-0r.next": "Respond",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-1r.char": "Of course. Look, I get a little faster every time.",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-1r.next": "Continue",
  "THE_ARCHITECT.talk.SLAY_THE_SPIRE2_MGR_MOD_CHARACTER_MGR_CHARACTER.2-2r.ancient": "There will be no next time."
}
